        def Xform "PencilCup" (
            prepend references = @../assets/stationery/stationery_models.usd@</Stationery/Pencilcup>
        )
        {
            double3 xformOp:translate = (-0.16, 0.12, 0.0365904756)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            over "Mesh" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
