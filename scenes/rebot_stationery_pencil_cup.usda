            def Xform "UVC32Mount" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @../assets/camera/UVC32_mount_portable.usd@
            )
            {
                rel material:binding = </World/Looks/UVC32Mount> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                quatd xformOp:orient = (0.7062529194, -0.0026105535, -0.0110436469, -0.7078686578)
                double3 xformOp:translate = (0.023151717, -0.0002007298, 0.0477621244)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                def Cube "UVC32Camera"
                {
                    rel material:binding = </World/Looks/UVC32PCB>
                    double size = 1
                    quatd xformOp:orient = (2.5746849097174618e-11, -7.67641505916572e-12, -0.29621554437178865, 0.9551211186004986)
                    double3 xformOp:scale = (0.032, 0.032, 0.0016)
                    double3 xformOp:translate = (0.0000014555909873983853, 0.08218025728194717, -0.0022930491725059363)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                    def Cylinder "LensHousing"
                    {
                        uniform token axis = "Z"
                        double height = 0.006
                        rel material:binding = </World/Looks/UVC32Housing>
                        double radius = 0.0065
                        double3 xformOp:translate = (0, 0, 0.0069)
                        uniform token[] xformOpOrder = ["xformOp:translate"]
                    }

                    def Cylinder "LensGlass"
                    {
                        uniform token axis = "Z"
                        double height = 0.001
                        rel material:binding = </World/Looks/UVC32Lens>
                        double radius = 0.0047
                        double3 xformOp:translate = (0, 0, 0.0094)
                        uniform token[] xformOpOrder = ["xformOp:translate"]
                    }

                    def Camera "FrontCamera"
                    {
