    def Scope "Lights"
    {
        def DomeLight "Dome"
        {
            color3f inputs:color = (0.94, 0.96, 1)
            float inputs:intensity = 800
        }

        def DistantLight "Key"
        {
            float inputs:angle = 4
            color3f inputs:color = (1, 0.94, 0.82)
            float inputs:intensity = 650
            quatd xformOp:orient = (0.8433914458128857, 0.5372996083468239, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:orient"]
        }

        def Cube "WarmStripVisual_1"
        {
            rel material:binding = </World/Looks/WarmLightStrip>
            double size = 1
            double3 xformOp:scale = (0.035, 0.44, 0.008)
            double3 xformOp:translate = (-0.2, 0.2, 0.625)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def RectLight "WarmStrip_1"
        {
            color3f inputs:color = (1, 0.84, 0.68)
            float inputs:colorTemperature = 4000
            bool inputs:enableColorTemperature = 1
            float inputs:height = 0.44
            float inputs:intensity = 950
            bool inputs:normalize = 1
            float inputs:width = 0.035
            double3 xformOp:translate = (-0.2, 0.2, 0.618)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "WarmStripVisual_2"
        {
