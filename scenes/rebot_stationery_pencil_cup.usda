#usda 1.0
(
    customLayerData = {
        dictionary renderSettings = {
            string "rtx:rendermode" = "PathTracing"
        }
    }
    defaultPrim = "World"
    endTimeCode = 1200
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render"
    startTimeCode = 0
    timeCodesPerSecond = 120
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.14, 0.16, 0.19)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "TableTop"
        {
            token outputs:surface.connect = </World/Looks/TableTop/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.16, 0.075)
                float inputs:metallic = 0
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "TableLegs"
        {
            token outputs:surface.connect = </World/Looks/TableLegs/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.06, 0.07)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.36
                token outputs:surface
            }
        }

        def Material "StationeryPBR"
        {
            token outputs:surface.connect = </World/Looks/StationeryPBR/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/StationeryPBR/DiffuseTexture.outputs:rgb>
                float inputs:metallic.connect = </World/Looks/StationeryPBR/ArmTexture.outputs:b>
                normal3f inputs:normal.connect = </World/Looks/StationeryPBR/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </World/Looks/StationeryPBR/ArmTexture.outputs:g>
                token outputs:surface
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "DiffuseTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../assets/stationery/textures/stationery_supplies_diff_4k.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/StationeryPBR/PrimvarReader.outputs:result>
                color3f outputs:rgb
            }

            def Shader "ArmTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../assets/stationery/textures/stationery_supplies_arm_4k.jpg@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/StationeryPBR/PrimvarReader.outputs:result>
                float outputs:b
                float outputs:g
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../assets/stationery/textures/stationery_supplies_nor_gl_4k.exr@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/StationeryPBR/PrimvarReader.outputs:result>
                normal3f outputs:rgb
            }
        }

        def Material "ReBotGreen"
        {
            token outputs:surface.connect = </World/Looks/ReBotGreen/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.278, 0.616, 0.298)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "ReBotBlack"
        {
            token outputs:surface.connect = </World/Looks/ReBotBlack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.055, 0.062)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "ReBotAluminium"
        {
            token outputs:surface.connect = </World/Looks/ReBotAluminium/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.8, 0.83)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "ReBotMotor"
        {
            token outputs:surface.connect = </World/Looks/ReBotMotor/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.13, 0.13, 0.14)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "GripperPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 2
            float physics:restitution = 0
            float physics:staticFriction = 2.4
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "StationeryPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.5
            float physics:restitution = 0
            float physics:staticFriction = 1.8
            uniform token physxMaterial:dampingCombineMode = "max"
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "WarmLightStrip"
        {
