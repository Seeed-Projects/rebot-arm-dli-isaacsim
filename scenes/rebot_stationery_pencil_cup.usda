        def RectLight "WarmStrip_2"
        {
            color3f inputs:color = (1, 0.84, 0.68)
            float inputs:colorTemperature = 4000
            bool inputs:enableColorTemperature = 1
            float inputs:height = 0.44
            float inputs:intensity = 950
            bool inputs:normalize = 1
            float inputs:width = 0.035
            double3 xformOp:translate = (0.2, 0.2, 0.618)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "WorkspaceBox" (
        prepend references = @../assets/workspace/box.usdz@
    )
    {
        double3 xformOp:scale = (0.9571788413098237, 0.8581358429039316, 1.0769230769230769)
        double3 xformOp:translate = (0, 0.044241756031979884, -0.5368030769230769)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        over "box"
        {
            over "Base_08q"
            {
                over "tn__131_m6"
                {
                    over "tn__13_"
                    {
                        over "Mesh" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                        )
                        {
                            uniform token physics:approximation = "none"
                        }
                    }
                }
            }

            over "DiskLight" (
                active = false
            )
            {
            }
        }
    }

