    def PhysicsFixedJoint "GraspAssistJoint" (
        active = false
        customData = {
            string purpose = "reliable_demo_grasp_assist"
        }
    )
    {
        rel physics:body0 = </World/Robot/link6>
        rel physics:body1 = </World/Objects/PenRed>
        bool physics:jointEnabled = 0
        point3f physics:localPos0 = (0, 0, 0.09121)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (0, -0.7071068, 0, -0.7071068)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def PhysicsCollisionGroup "GripperFingerNoCollideGroup"
    {
        rel collection:colliders:includes = [
            </World/Robot/gripper_left>,
            </World/Robot/gripper_right>,
        ]
        prepend rel physics:filteredGroups = </World/GripperFingerNoCollideGroup>
    }

