                over "Mesh"
                {
                    over "Mesh" (
                        prepend apiSchemas = ["PhysxCollisionAPI", "PhysxSDFMeshCollisionAPI", "NewtonCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysxTriangleMeshSimplificationCollisionAPI", "PhysxSphereFillCollisionAPI"]
