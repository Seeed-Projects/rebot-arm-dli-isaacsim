                double3 xformOp:translate = (-0.49, -0.17, -0.24661692566)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Leg_2" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/Looks/TableLegs>
                double size = 1
                double3 xformOp:scale = (0.065, 0.065, 0.38676614868)
                double3 xformOp:translate = (-0.49, 0.61, -0.24661692566)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Leg_3" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/Looks/TableLegs>
                double size = 1
                double3 xformOp:scale = (0.065, 0.065, 0.38676614868)
                double3 xformOp:translate = (0.49, -0.17, -0.24661692566)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Leg_4" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </World/Looks/TableLegs>
                double size = 1
                double3 xformOp:scale = (0.065, 0.065, 0.38676614868)
                double3 xformOp:translate = (0.49, 0.61, -0.24661692566)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "VialRack" (
            prepend references = @../assets/stationery/Vial_rack_simple.usda@
        )
        {
            double3 xformOp:translate = (0.1, 0.16, 0.006)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            over "Body1"
            {
                bool physics:kinematicEnabled = 1

                over "Mesh"
                {
                    over "Mesh" (
                        prepend apiSchemas = ["PhysxCollisionAPI", "PhysxSDFMeshCollisionAPI"]
                    )
                    {
                        float physxCollision:contactOffset = 0.0003
                        float physxCollision:restOffset = 0
                        uniform float physxSDFMeshCollision:sdfMargin = 0.001
                        uniform float physxSDFMeshCollision:sdfNarrowBandThickness = 0.002
                    }
                }
            }

            over "Looks"
            {
                over "OmniPBR"
                {
                    over "Shader"
                    {
                        color3f inputs:diffuse_color_constant = (0.943, 0.241, 0.13)
                    }
                }
            }
        }

        def Cube "Floor" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/Looks/Floor>
            double size = 1
            double3 xformOp:scale = (4, 4, 0.06)
            double3 xformOp:translate = (0, 0, -0.47)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "Robot" (
        prepend references = @../assets/so101/SO-ARM101-USD-NO-CAMERA.usd@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-0.0208, 0.45, -0.0301)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        over "root_joint"
        {
            point3f physics:localPos0 = (-0.0208, 0.45, -0.0301)
            quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
        }

        over "base" (
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 0
            int physxArticulation:solverPositionIterationCount = 32
            int physxArticulation:solverVelocityIterationCount = 1
        }

        over "joints"
        {
            over "Rotation"
            {
                float physxJoint:maxJointVelocity = 240
            }

            over "Pitch"
            {
                float physxJoint:maxJointVelocity = 240
            }

            over "Elbow"
            {
                float physxJoint:maxJointVelocity = 240
            }

            over "Wrist_Pitch"
            {
                float physxJoint:maxJointVelocity = 240
            }

            over "Wrist_Roll"
            {
                float physxJoint:maxJointVelocity = 240
            }

            over "Jaw"
            {
                float physxJoint:maxJointVelocity = 120
            }
        }

        over "Looks"
        {
            over "material_a_3d_printed"
            {
                over "Shader"
                {
                    color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.91)
                }
            }
        }

        over "gripper"
        {
            over "collisions" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/SO101GripperPhysics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }

            def Xform "WristCameraMount"
            {
                quatd xformOp:orient = (0.9238795325112867, -0.3826834323650898, 0, 0)
                double3 xformOp:translate = (-0.005, 0.06, -0.062)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                def Cube "Body"
                {
                    rel material:binding = </World/Looks/SO101WristCamera>
                    double size = 1
                    double3 xformOp:scale = (0.024, 0.024, 0.007)
                    double3 xformOp:translate = (0, 0, 0.009)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cylinder "Lens"
                {
                    uniform token axis = "Z"
                    double height = 0.005
                    rel material:binding = </World/Looks/SO101WristCameraLens>
                    double radius = 0.006
                    double3 xformOp:translate = (0, 0, 0.004)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }

                def Camera "FrontCamera"
                {
                    float2 clippingRange = (0.01, 100)
                    float focalLength = 11.04
                    float focusDistance = 0.16
                    float horizontalAperture = 20.955
                    float verticalAperture = 15.71625
                }
            }
        }

        over "jaw"
        {
            over "collisions" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/SO101GripperPhysics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }
    }

